# staffweave のローカル実行に必要な環境変数。
# このファイルをコピーして .env を作成してください。実際の秘密情報はコミットしないでください。

# docker compose がホスト側へ公開する PostgreSQL のポート
DB_HOST_PORT=5433

# PostgreSQL 接続文字列
DATABASE_URL=postgres://staffweave:staffweave@localhost:5433/staffweave

# 統合テスト用のデータベース（本番用とは必ず分けること）
TEST_DATABASE_URL=postgres://staffweave:staffweave@localhost:5433/staffweave_test

# API サーバー
API_PORT=8787
API_HOST=127.0.0.1

# Web 開発サーバー
WEB_PORT=5173

# 実行環境の表示名（development / test / production）
NODE_ENV=development

# ログイン時にワークスペースが指定されなかった場合の既定値
DEFAULT_WORKSPACE_SLUG=default

# Webhook 送信ワーカー。API は送信待ちを記録するだけで、送信はワーカーが行います。
# これらを読むのはワーカーだけです。値を誤っても API の起動は妨げません。
# 値を省略すると既定値を使います。占有時間は送信の上限より大きくしてください。
WEBHOOK_WORKER_POLL_INTERVAL_MS=5000
WEBHOOK_SEND_TIMEOUT_MS=10000
WEBHOOK_CLAIM_LEASE_MS=60000

# IC カードの指紋を計算するための鍵。
# データベースへは保存せず、端末の登録時に Agent へ渡します。
# 未設定の場合、IC カード機能は使えません。値を変えると既存のカード登録は無効になります。
CARD_FINGERPRINT_KEY=change-me-to-a-long-random-value
