# staffweave のローカル実行に必要な環境変数。
# このファイルをコピーして .env を作成してください。実際の秘密情報はコミットしないでください。

# docker compose が作る PostgreSQL の資格情報。
# 公開する場合は必ず変更してください。db・app・worker はこの値を共有します。
#
# パスワードは接続文字列（URL）へそのまま入るため、URL で意味を持つ文字
# （@ : / ? # [ ] 空白）を含めないでください。英数字と - _ . ~ の範囲で作れば安全です。
#
#   openssl rand -hex 24
#
DB_USER=staffweave
DB_PASSWORD=staffweave
DB_NAME=staffweave

# docker compose がホスト側へ公開する PostgreSQL の結び付け先とポート。
# 既定はループバックだけです。他のホストから直接つなぐ場合にのみ広げてください。
DB_HOST_BIND=127.0.0.1
DB_HOST_PORT=5433

# アプリケーション（--profile app）の結び付け先とポート。
# 既定はループバックだけです。前段で HTTPS を終端し、そこから転送する構成を想定しています。
APP_HOST_BIND=127.0.0.1
APP_HOST_PORT=8787

# PostgreSQL 接続文字列。DB_USER / DB_PASSWORD / DB_NAME を変えたら、ここも合わせてください。
DATABASE_URL=postgres://staffweave:staffweave@localhost:5433/staffweave

# 統合テスト用のデータベース（本番用とは必ず分けること）
TEST_DATABASE_URL=postgres://staffweave:staffweave@localhost:5433/staffweave_test

# API サーバー
API_PORT=8787
API_HOST=127.0.0.1

# Web 開発サーバー
WEB_PORT=5173

# 実行環境の表示名（development / test / production）
NODE_ENV=development

# ログイン時にワークスペースが指定されなかった場合の既定値
DEFAULT_WORKSPACE_SLUG=default

# ログインの失敗を何回まで受け付けるか。これを読むのは API だけです。
# 上限に達すると、その単位（利用者／送信元）からの受け付けを LOGIN_BLOCK_MS のあいだ断ります。
# 断っているあいだはパスワードの照合そのものを行いません。
# 最後に数え始めてから LOGIN_FAILURE_WINDOW_MS が過ぎたら 0 から数え直します。
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_SOURCE=50
LOGIN_FAILURE_WINDOW_MS=900000
LOGIN_BLOCK_MS=900000

# 送信元を X-Forwarded-For の先頭から決めるかどうか（true / false）。
# 前段の逆プロキシがこの頭書きを必ず書き換える構成でだけ true にしてください。
# 直接受ける構成で true にすると、送信元を自由に名乗れて数える意味がなくなります。
TRUST_PROXY_FOR_CLIENT_ADDRESS=false

# Cookie の資格情報を使う要求で許す送信元。カンマ区切り。これを読むのは API だけです。
# 省略すると、要求が届いた宛先（Host）と同じホストだけを許します。
# 逆プロキシが Host を書き換える構成では、画面が実際に置かれるオリジンを並べてください。
#
#   ALLOWED_ORIGINS=https://staffweave.example.com
#
ALLOWED_ORIGINS=

# 要求本文の大きさの上限（バイト）。これを読むのは API だけです。
# 超えた要求は本文を読み切らずに 413 で断ります。
# MAX_REQUEST_BODY_BYTES はふつうの要求（打刻・認証・端末からの送信）に使います。
# MAX_BULK_REQUEST_BODY_BYTES は従業員の CSV 取り込みだけに使います。
# 逆プロキシ側にも上限がある場合は、小さいほうが先に効きます。
MAX_REQUEST_BODY_BYTES=262144
MAX_BULK_REQUEST_BODY_BYTES=8388608

# API キーの「最後に使った時刻」を書き直す間隔（ミリ秒）。これを読むのは API だけです。
# この値より新しい記録があれば書き直しません。要求のたびに書くと、読み取りだけの要求にも
# 書き込みの待ち時間が乗り、同じキーを使う要求どうしが同じ行の更新で待ち合わせます。
# 記録は、使われなくなったキーを見つけるためのものです。この間隔だけ古く見えます。
API_KEY_USAGE_INTERVAL_MS=60000

# Webhook 送信ワーカー。API は送信待ちを記録するだけで、送信はワーカーが行います。
# これらを読むのはワーカーだけです。値を誤っても API の起動は妨げません。
# 値を省略すると既定値を使います。
# 占有時間は、送信上限に最低 5000 ミリ秒の完了猶予を加えた値以上にしてください。
WEBHOOK_WORKER_POLL_INTERVAL_MS=5000
WEBHOOK_SEND_TIMEOUT_MS=10000
WEBHOOK_CLAIM_LEASE_MS=60000

# Webhook の送信先。既定は公開ネットワークだけを許します。
# これは API とワーカーの両方が読みます。値を揃えないと、登録できた送信先へ送れません。
# 内部サービスへ送るセルフホスト環境では、危険性を理解したうえで allow-local を指定します。
# allow-local でも、リンクローカルやクラウドのメタデータサービス宛は常に拒否します。
# 拒否する範囲の一覧は docs/security/webhook-target-policy.md を参照してください。
WEBHOOK_NETWORK_POLICY=public-only

# 送信先の登録時に、URL と名前解決を確かめる上限時間。これを読むのは API だけです。
# 送信時は WEBHOOK_SEND_TIMEOUT_MS を使います。
WEBHOOK_TARGET_VALIDATION_TIMEOUT_MS=3000

# IC カードの指紋鍵の元になる共通の鍵。32 文字以上の推測できない値を設定してください。
#
#   openssl rand -hex 32
#
# データベースへは保存しません。端末の登録時に渡すのは、この値から
# Workspace ごとに導出した鍵です。未設定なら IC カードの経路は無効になります。
# 値を変えると導出した鍵も変わり、登録済みのカードは登録し直しになります。
CARD_FINGERPRINT_KEY=
