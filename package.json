{
  "name": "staffweave",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "\u30bb\u30eb\u30d5\u30db\u30b9\u30c8\u53ef\u80fd\u306a\u52e4\u6020\u7ba1\u7406\u57fa\u76e4",
  "license": "MIT",
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"@staffweave/api\" --filter \"@staffweave/web\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "bootstrap": "pnpm --filter \"@staffweave/api\" bootstrap",
    "webhook:worker": "pnpm --filter \"@staffweave/api\" webhook-worker",
    "db:migrate": "pnpm --filter \"@staffweave/db\" migrate",
    "db:status": "pnpm --filter \"@staffweave/db\" status",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm db:verify && pnpm check:policy && pnpm check:audit",
    "test:e2e": "playwright test",
    "agent": "pnpm --filter \"@staffweave/agent\" start",
    "seed:demo": "pnpm --filter \"@staffweave/api\" seed:demo",
    "backup": "./scripts/backup.sh",
    "restore": "./scripts/restore.sh",
    "check:policy": "./scripts/check-policy.sh",
    "check:audit": "./scripts/check-audit.sh",
    "db:verify": "pnpm --filter \"@staffweave/db\" verify"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@playwright/test": "^1.62.0",
    "@staffweave/api": "workspace:*",
    "@staffweave/db": "workspace:*",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
