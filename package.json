{
  "name": "staffweave",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "セルフホスト可能な勤怠管理基盤",
  "license": "MIT",
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"@staffweave/api\" --filter \"@staffweave/web\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "pnpm --filter \"@staffweave/db\" migrate",
    "db:status": "pnpm --filter \"@staffweave/db\" status",
    "verify": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@staffweave/db": "workspace:*",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
