{
  "name": "@staffweave/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "bootstrap": "tsx --env-file-if-exists=../../.env src/cli/bootstrap.ts",
    "webhook-worker": "tsx --env-file-if-exists=../../.env src/cli/run-webhook-worker.ts",
    "typecheck": "tsc --noEmit",
    "seed:demo": "tsx --env-file-if-exists=../../.env src/cli/seed-demo.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@staffweave/contracts": "workspace:*",
    "@staffweave/db": "workspace:*",
    "@staffweave/domain": "workspace:*",
    "hono": "^4.12.33",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@staffweave/agent": "workspace:*",
    "@staffweave/connector": "workspace:*",
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
